# Optional. AlphaLab Phase 1 works without API keys.
ALPHALAB_DATABASE_URL=sqlite:///data/alpha_lab.db
ALPHALAB_CONFIG=config/default.yaml
# OPENAI_API_KEY=  # Reserved for the optional Phase 3 document analyst.
# Optional Phase 3 AI provider; deterministic tests do not require this.
ALPHALAB_AI_PROVIDER=disabled
OPENAI_API_KEY=
ALPHALAB_QUERY_PROVIDER=deterministic
